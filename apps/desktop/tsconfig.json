{
  "extends": "../../config/tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "outDir": "./dist-electron",
    "rootDir": ".",
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "types": ["node"]
  },
  "include": ["electron/**/*", "tsup.config.ts"],
  "exclude": ["electron/**/*.test.ts"]
}
